{
  "name": "call-tips-win",
  "version": "0.1.0",
  "description": "AI interview coaching overlay — Electron, cross-platform (Win + Mac)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ru.recruiter-assistant.call-tips",
    "productName": "Call Tips",
    "files": ["main.js", "preload.js", "renderer/**/*", ".env"],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
