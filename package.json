{
  "name": "call-tips-win",
  "version": "0.1.0",
  "description": "AI interview coaching overlay — Electron, cross-platform (Win + Mac)",
  "main": "main.js",
  "scripts": {
    "start": "node_modules/.bin/electron .",
    "postinstall": "xattr -cr node_modules/electron/dist/ 2>/dev/null || true; codesign --force --deep --sign - node_modules/electron/dist/Electron.app 2>/dev/null || true",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ru.recruiter-assistant.call-tips",
    "productName": "Call Tips",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      ".env"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
